doi = {10.4324/9780203966884},
file = {:C\:/07_THEORIE/Architecture/General/Architecture in Words Theatre, Language and the Sensuous Space of Architecture by Louise Pelletier (z-lib.org).pdf:pdf},
isbn = {0415394716},
