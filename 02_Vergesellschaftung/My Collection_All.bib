@incollection{Lits1977,
abstract = {The idea of the "mirror stage" is an important early component in Lacan's critical reinterpretation of the work of Freud and symbolic analysis. Lacan suggests that human infants pass through a stage in which an external image of the body (reflected in a mirror) produces a psychic response that gives rise to the mental representation of an "I". The infant identifies with the image, which serves in the infant's emerging perceptions of selfhood. Because the image of a unified body does not correspond with the underdeveloped infant's physical vulnerability and weakness, this image is established as an Ideal-I toward which the subject will perpetually strive throughout his or her life. For Lacan, the mirror stage establishes the ego as fundamentally dependent upon external objects, on an other. As the so-called "individual" matures and enters into social relations through language, this "other" will be elaborated within social and linguistic frameworks that will give each subject's personality (and his or her neuroses and other psychic disturbances) its particular characteristics.},
annote = {Type reclassified misc->incollection on 2026-07-26, automated candidate: has booktitle= ('Notes'). NOT independently verified, please confirm against the source PDF before citing.
[missingpdf-relink-2026-07-26: 1 file path(s) resolved via Mendeley missing-pdf export cross-reference, method=basename-match-excl-duplicates-to-delete]},
author = {Lits, Richard L W Clarke},
booktitle = {Notes},
file = {:C\:/07_THEORIE/_OCR_QUEUE/J_Lacan_The Mirror Stage as function of the I as Revealing in Psychoanalytic Experience.pdf:pdf},
number = {2},
pages = {2--5},
title = {{“ the Mirror Stage As Formative of the Function of the I}},
year = {1977}
