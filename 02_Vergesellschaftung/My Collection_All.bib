@book{Ruggeri2020,
abstract = {The reduction of functional groups is one of the fundamental reactions of organic chemistry. Many bond-forming transformations are carried out on highly oxidized molecules because they possess greater reactivity. Various methods have been developed to effect the reduction of a wide variety of functional groups; the two most commonly used are hydride-based reagents or conditions that employ hydrogen gas with a catalyst. This chapter describes the most successfully utilized conditions, commencing with information on the reduction of carbon-carbon bonds. It then reviews the practical methods for the reduction of various carbon-nitrogen bonds. Discussions on the reduction of carbon-oxygen bonds, carbon-sulfur bonds, carbon-halogen bonds and heteroatom-heteroatom bonds follow. The reduction of nitrogen-nitrogen bonds is often an important step in synthetic sequences that utilize azides, hydrazones, and diazo compounds.},
annote = {Relinked in V7: original file path was dead on disk; matched to file that appears moved/renamed.},
