@article{Romm1983,
abstract = {Contends that the July 19, 1938 meeting with Sigmund Freud was the culmination of years of planning and dreaming on the part of Salvador Dal{\'{i}} as evidenced by his past and the pictures he drew after their meeting. Dal{\'{i}} was born 3 yrs after the death of a 7-yr-old gifted brother and was treated as a replacement (or reincarnation) of the dead boy. His exhibitionistic, rebellious, and eccentric behavior began early in an effort to prove that he was not the dead brother, but the living one. He began his idealized relationship with Freud and psychoanalysis in 1925 while a student at the School of Fine Arts. He tried to present himself to Freud on 3 occasions in Vienna. His feelings about Freud can be seen in 4 portraits of Freud, 1937–1938. There were some similarities between Freud and Dal{\'{i}}'s father; both were seen as elusive and as men of distinction, both used writing as an integral part of their profession, and both were viewed as godlike. The final drawing of Freud, after the meeting, reveals Dal{\'{i}}'s rage at Freud's rejection and projects his own feelings on the dying Freud. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
author = {Romm, Sharon and Slap, Joseph W},
file = {:C\:/07_THEORIE/Authors/Freud/Romm-SigmundFreudSalvador-1983.pdf:pdf},
journal = {American Imago},
keywords = {Art,Artists,Biography,Drawing,Freud (Sigmund),Psychoanalytic Interpretation,meeting between Freud & S. Dali & psychoanalytic a},
number = {4},
pages = {337--347},
title = {{Sigmund Freud and Salvador Dal{\'{i}}: Personal moments}},
url = {http://search.ebscohost.com/login.aspx?direct=true&db=psyh&AN=1985-04076-001&lang=es&site=ehost-live},
volume = {40},
year = {1983}
}
