@article{Nichols2009,
abstract = {What's their theoretical PoV? The causes: 1. "Blame has been laid first and foremost on the Internet, for luring away advertisers and readers, 2. and on the economic meltdown, which has demolished revenues 3. and hammered debt-laden media firms." [i could talk here about the case of the Tribune] The existing solutions: 1. Closing the print edition 2. "Layoffs of reporters and closings of bureaus mean that even if newspapers survive, they have precious few resources for actually doing journalism." 3. online collaboration/citizens will do the job Suggested solutions they reject: 1. philantropy/foundations 2. micropayments "We begin with the notion that journalism is a public good, that it has broad social benefits far beyond that between buyer and seller. Like all public goods, we need the resources to get it produced. This is the role of the state and public policy." It is similar to education or the military The "free" media market is a fiction. Government has always supported some media outlets and still does. Only now it supports a narrow group of commercial media firms. The solution is government intervention in the service of a non-profit press which will result in multiple news rooms across the U.S. To an extent, what they're proposing is a bridge loan - they have no long term plan; it's not clear how they really guard against governmental influence 1. Free postage for magazines with limited ad revenue 2. Tax credit for newspaper subscriptions for newspapers that are "newsy" enough 3. Funding school news outlets 4. Expand funding of public broadcasting to create bigger non-profit newsrooms perhaps based on legacy newspapers facing closure "Ideally the next media system will have a combination of the above; and the government should be prepared to rewrite rules and regulations and to use its largesse to aid a variety of sound initiatives." - a diversity of ownership models },
author = {Nichols, John and McChesney, Robert W},
file = {:C\:/07_THEORIE/Authors/Jacobs/Jacobs - 1961 - The Death and LIfe of Great American Cities - Unknown.pdf:pdf},
issn = {00278378},
journal = {Nation},
number = {13},
pages = {11--14},
title = {{The death and life of great American newspapers}},
volume = {288},
year = {2009}
}
