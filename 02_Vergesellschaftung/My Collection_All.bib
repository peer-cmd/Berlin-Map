@book{Fauvarque-Cosson2009,
abstract = {The Association Henri Capitant des Amis de la Culture Juridique Fran{\c{c}}aise and the Soci{\'{e}}t{\'{e}} de l{\'{e}}gislation compar{\'{e}}e joined the academic network on European Contract Law in 2005 to work on the elaboration of a "common terminology" and on "guiding principles," as well as to propose a revised version of the Principles of European Contract Law (PECL). The results of this work were sent to the European Commission and have already been published in French. The English translation is now being published by sellier.elp. This work contributes to the wider European project. The part on the guiding principles could be a component of the Common Frame of Reference (CFR), in the form of "black letter" model rules or recitals. The part on terminology is, in itself, useful for the elaboration of the final various linguistic versions of the CFR. It finds its place within the materials which will accompany the model rules. Last but by no means least, the revised version of the PECL should be considered by the European institutions as an alternative set of model rules on contract law. {\textcopyright}2008 by sellier. european law publishers, Munich. All rights reserved.},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
