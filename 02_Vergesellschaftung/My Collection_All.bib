@article{Hui2023,
abstract = {Yuk Hui subtly reminds us that eschatology—the part of theology concerned with death and finality—is not necessarily a horseman signaling actual end times, but is merely a device for contemplating ultimate outcomes. As such, it is inherited from Abrahamic thinking, but is furthermore an imaginative device for projecting a final destiny from more immediate tendencies that might appear conflicting or illegible when taken on their own terms. Hui faces the fears surrounding ChatGPT, urging us toward a deeper understanding of artificial intelligence—in order to identify the imaginative leap we are being asked to make.},
