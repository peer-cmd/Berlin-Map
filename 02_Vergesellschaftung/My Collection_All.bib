@article{Nicolas2012,
abstract = {Between 1892 and 1904, Alfred Binet (1857-1911) produced, in the psychology laboratory of the Sorbonne, a whole set of original works that still remains little known today. He integrated the laboratory, directed by the psychophysiologist Henry Beaunis (1830-1921), in 1891. We describe the circumstances that led Binet to take the direction of this laboratory in 1895 and present scientific investigations that were conducted there by Binet and his collaborators. For Binet, the laboratory was not narrowly limited to a set of rooms where experiments were conducted by means of sophisticated devices (experimental psychology), it was also a working area, regularly organized, where all the psychological documents were classified, whatever their origin (descriptive psychology). We show that Binet was a pioneer who is still little recognized in various areas of experimental psychology. Binet suffered, at the time, from the indifference of his contemporaries, but he especially regretted not being able to attract students to his laboratory due to the absence of diploma-offering programs. {\textcopyright}2012 American Psychological Association.},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Nicolas, Serge and Sanitioso, Rasyid Bo},
doi = {10.1037/a0028060},
file = {:C\:/07_THEORIE/Disciplines/Aesthetics/Scientific Aesthetics/AP-NGS2011(1).pdf:pdf},
issn = {10934510},
journal = {History of Psychology},
keywords = {Binet,Experimental psychology,History of French psychology,Laboratory,Sorbonne University},
number = {4},
pages = {328--363},
title = {{Alfred Binet and experimental psychology at the Sorbonne laboratory}},
volume = {15},
year = {2012}
}
@article{Hagen2010,
abstract = {In City and Cosmos, Keith D. Lilley argues that the medieval mind considered the city truly a microcosm: much more than a collection of houses, a city also represented a scaled-down version of the very order and organization of the cosmos. Drawing upon a wide variety of sources, including original accounts, visual art, science, literature, and architectural history, City and Cosmos offers an innovative interpretation of how medieval Christians infused their urban surroundings with meaning.\n\n Lilley combines both visual and textual evidence to demonstrate how the city carried Christian cosmological meaning and symbolism, sharing common spatial forms and functional ordering. City and Cosmos will not only appeal to a diverse range of scholars studying medieval history, archaeology, philosophy, and theology; but it will also find a broad audience in architecture, urban planning, and art history. With more of the world's population inhabiting cities than ever before, this original perspective on urban order and culture will prove increasingly valuable to anyone wishing to better understand the role of the city in society.},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Hagen, Joshua},
doi = {10.1016/j.jhg.2010.02.014},
file = {:C\:/07_THEORIE/IGTG/Commons/Mittelalter/City and Cosmos The Medieval World in Urban Form (Keith D. Lilley).pdf:pdf},
issn = {03057488},
journal = {Journal of Historical Geography},
number = {2},
