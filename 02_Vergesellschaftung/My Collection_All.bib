@article{Pottage2016,
abstract = {Alain Pottages essay Architectural Authorship* inserts itself within the analysis of architecture at an odd angle ? that of the law. Few architectural theorists treat the relation of architecture and the law, save as an external and contingent relation in which the law constrains and regulates architectural practice. It may determine the status of the architect, assign the duties and limits of the architects responsibilities, arbitrate over the relation of designs and the regulatory framework of planning, zoning and standards. Yet there is nothing architectural about this relation, however influential and effective the law may prove in determining what is built. But in the last twenty years there has arisen an intellectual analysis of the law which treats it not just as an institution of regulation but as a form of categorization whose social impact, if largely unnoticed and even unconscious, is pervasive and far greater than is suggested by the term 'legal. The hypothesis is that many of our ways of thinking are 'juridical' in areas of thought far removed from the legal, and even in forms which are evidently critical of the law. Perhaps a parallel can be drawn with the work of Jacques Derrida. Architects are now used to the idea of the ways in which the history of philosophy has shaped and repressed elements of architectural discourse. We cannot avoid confronting the issue of how a category such as space has been determined by the decisions of philosophy, not just as an instance of'influence', but in the very way that the control of the definition of space allows philosophy a definite space. The history of philosophy is internal to the development of architectural categories. The basis of Alain Pottage's investigation is the way in which Le Corbusier draws upon, unconsciously, a dimension of juridical discourse in fashioning his project, and how as a consequence he is limited in his argument. The result is unexpected and exemplary. Indeed it is unsettling for architectural theory. This can be seen in at least two aspects of the essay. The first concerns the question of architectural creativity and authorship. Like most arenas of artistic or literary production, architecture cherishes the idea of the creativity of a great architect where creativity indicates a zone of freedom and innovation, through which the architect proposes new solutions to problems, and stamps them with a 'personality'. It is therefore wounding to the pride of any practice to discover that this very category of creativity and 'personality' has been loaned to it by jurisprudence, and that its function is to resolve essentially legal issues. 'Freedom' here turns out to be based upon a legal fiction. Secondly, andfrom the point of view ofarchitectural theory even more troubling, is the argument that architecture's relation to geometry derives not just from a formal analysis of space but from the field of social regulation. The relation between construction and geometry is forced by Alain Pottage to disclose a wish to constrain subjects in an orthopaedic urbanism which repeats, unwittingly, many of the devices of juridical discourse. This argument allows him to reposition, in a fundamentalfashion, the relation between Le Corbusier and technology. Without endorsing him, Pottage uses Heidegger's argument to demonstrate the scale ofLe Corbusiers conceptualfailure. The essay is the beginning of an investigation of the ways in which juridical discourse may have determined unconscious elements of architectural argument. 64 AA FILES 31 This content downloaded from 128.95.104.66 on Mon, 09 Oct 2017 03:26:05 UTC All use subject to http://about.jstor.org/terms},
author = {Pottage, Alain},
file = {:C\:/07_THEORIE/Authors/Corbusier/Pottage - 2016 - Architectural Authorship The Normative Ambitions of Le Corbusier's Modulor - AA Files.pdf:pdf},
journal = {AA Files},
number = {31},
pages = {64--70},
title = {{Architectural Authorship: The Normative Ambitions of Le Corbusier's Modulor}},
volume = {31},
year = {2016}
}
