issn = {00457949},
journal = {Computers and Structures},
keywords = {Bending,Dynamic relaxation,Finite difference,Form finding,Structural analysis,Torsion},
pages = {60--67},
title = {{A novel torsion/bending element for dynamic relaxation modeling}},
