@article{Anderson1997,
abstract = {Architecture frames the measure of man. The contemporary photographer Karen Knorr offers the phrase “The Search for the True Spirit of Antiquity” as a legend to her view of the interior of eighteenth-century Chiswick House (fig. 1). 1 This image, part of her series titled Connoisseurs, frames an elegant and somberly dressed man within the vista of two highly ornate classical door frames. The man, turned away from us and gazing out toward the garden, hides his identity and his emotions, while the architecture glows with gold against plain walls. Architecture bears the burden of expression, preserving personal anonymity even in an interior, domestic space. In this setting Knorr's use of the term antiquity evokes both the ancient models for the architecture as well as the noblesse of the man in this space. The presence of antiquity forms the past, and anticipation of its true spirit frames the condition of the present. {\textcopyright}1997, College Art Association, Inc.},
author = {Anderson, Christy},
doi = {10.1080/00043249.1997.10791818},
file = {:C\:/07_THEORIE/Authors/Jones, Inigo/Anderson-MasculineUnaffectedInigo-1997.pdf:pdf},
issn = {00043249},
journal = {Art Journal},
number = {2},
pages = {48--54},
title = {{Masculine and unaffected: Inigo Jones and the classical ideal}},
volume = {56},
year = {1997}
}
