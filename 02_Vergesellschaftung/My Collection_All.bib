@article{Bijvoet1997,
abstract = {Art as Inquiry presents an alternative approach to the history of art and technology and art in the environment since the mid-sixties. Focusing on the search for a new concept of art, and a different function for the artist, this book discusses recent developments in Art in Public Places and Media Art in terms of new modes of interdisciplinary production and collaboration. In addition, Marga Bijvoet argues, the nature of inquiry of these art works requires a 'field' interpretation, which perceives art as a set of relations in context. She suggests that this 'movement' might eventually bear the seed for a new paradigm of the visual arts. Ch. 1. Interdisciplinary Collaborations: Ideas. Catalysts: Gyorgy Kepes, Billy Kluver and Jack Burnham -- Ch. 2. Interdisciplinary Collaborations: Projects -- Ch. 3. Art as a Set of Relations. Jack Burnham: The Systems Approach -- Ch. 4. Hans Haacke: Systems Artist. Hans Haacke and Jack Burnham: Exchange of Ideas -- Ch. 5. Robert Smithson: In Search of a Different Paradigm for Sculptural Space -- Ch. 6. Expanded Moves into the Environment. James Turrell's Vision of the Sky Perceptual Spaces. The Roden Crater. Nancy Holt: Contextual Site-works Astrophysical Connections. Design of an Urban Landscape Park. Sky Mound -- Ch. 7. Robert Irwin: Art as Inquiry -- Ch. 8. The Artist as Ecologist. Alan Sonfist: Nature as Material. The Harrisons: An Ecological Argument A Self-generating Ecosystem -- Ch. 9. Toward an Art in Public Places -- Ch. 10. Nam June Paik: Media Visions -- Ch. 11. Bill Viola: A Close Re-View of Visual Reality. Ch. 12. Paul Ryan: From Guerilla Television to Ecochannel -- Ch. 13. The Vasulkas: Video Phenomenology.},
annote = {Relinked in V7: original file path was dead on disk; matched to file that appears moved/renamed.},
author = {Bijvoet, Marga},
file = {:C\:/07_THEORIE/IGTG/Semiotik - Cybernetiks/Jack Burnham/Bijvoet_Marga_1997_Jack_Burnham_The_Systems_Approach.pdf:pdf},
isbn = {9780820433820},
journal = {Art as inquiry: toward new collaborations between art, science, and technology},
pages = {67--74},
title = {{Jack Burnham: The Systems Approach}},
url = {http://www.worldcat.org/title/art-as-inquiry-toward-new-collaborations-between-art-science-and-technology/oclc/35235034?referer=di&ht=edition},
