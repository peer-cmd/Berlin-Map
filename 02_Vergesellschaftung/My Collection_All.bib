@article{Colla2017,
abstract = {This article considers the fate of Prussian buildings and memorials in East Germany between 1945 and 1961. Analyzing a number of case studies from Berlin and Potsdam, it places the treatment of these structures within the broader contours of history management practices. Although this era was characterized by a strong anti-Prussian sentiment in the GDR's historical discourse, it also witnessed a complex interaction between the SED and its historical inheritance. This interaction often influenced decisions about the fate of Prussian structures in the GDR as much as any animosity toward Prussia as a historical entity did.},
