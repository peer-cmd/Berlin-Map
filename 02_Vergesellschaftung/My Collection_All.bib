@article{Dyrness2009,
abstract = {In the last two centuries, Christian theologians have revived a conversation on the role of art and aesthetics in theology that had been eclipsed during the Reformation. Many medieval thinkers saw the arts as theological practices that were intimately related to worship. Music, architecture, altarpieces, and, later, smaller devotional images, were understood to communicate the presence of God. The world as God's creation, the incarnation of Christ in human form, and the reading and interpretation of scripture all stimulated the practices of art and literature. This article explores these modern discussions. Exactly how the arts are thought to relate to God varies, but all the writers explored here agree that aesthetic reality incorporates a critical component of created life and can not only contribute to spiritual health, but may reflect or embody God's presence. Art and aesthetics is used here in the broad sense, including both object and experience.},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Dyrness, William A},
doi = {10.1093/oxfordhb/9780199245765.003.0032},
file = {:C\:/07_THEORIE/_ToSort/Dyrness - 1909 - The Arts connected with Buildings. Lectures on Craftsmanship and Design Delivered at Carpenters Hall London Wall for th.pdf:pdf},
isbn = {9780191577147},
journal = {The Oxford Handbook of Systematic Theology},
keywords = {Aesthetic reality,Christian theologians,Protestant art,Reformation,Systematic theology},
title = {{The Arts}},
year = {2009}
}
