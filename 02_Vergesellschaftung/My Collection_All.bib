isbn = {1573382300192},
issn = {15733823},
keywords = {David Gooding,Francis Bacon,J.E. Tiles,Peter Dear,Robert Boyle,Robert Hooke,Thomas Kuhn,experiment,experimental philosophy,experimentum crucis,natural history},
number = {2},
pages = {103--132},
