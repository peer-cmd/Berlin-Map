@article{Kammer2005,
abstract = {Louis Hay \n\n74f\nDer Textbegriff ist das Resultat einer in ihrer historischen Dimension einzigartigen Entwicklung. Sie umfasst eine Phase gro{{\ss}}er Stabilit{{\"{a}}}t von langer Dauer und eine kurze neuere Periode, in der sich die {{\"{A}}}nderungen {{\"{u}}}berst{{\"{u}}}rzt haben. Erstere f{{\"{u}}}hrt uns ins monastische Mittelalter zur{{\"{u}}}ck. Sp{{\"{a}}}testens seit dem 13. Jahrhundert findet sich in den verschiedenen europ{{\"{a}}}ischen Nationalsprachen die Umbildung von //textus// im Sinn von ›Gewebe‹ zum //Text// im aktuellen Verst{{\"{a}}}ndnis des Begriffs belegt. Zu Beginn der Moderne ist diese Bedeutung in der reinen mittelalterlichen Tradition kodifiziert\n\n77:\nZu diesem Zeitpunkt verzweigten sich auch die Wege der Forschung in verschiedenen L{{\"{a}}}ndern, und die Bedeutung des Begriffs wurde so fragmentiert, dass in einem internationalen Diskussionskontext niemand mehr von »Text« sprechen konnte, ohne vorher eine spezifische Definition des Begriffes vorzulegen.\n\n85:\nDer 1972 von Jean Bellemin-No{{\"{e}}}l vorgeschlagene Begriff des »avant-texte« hat sich inzwischen zu Recht durchgesetzt. Er hat es erm{{\"{o}}}glicht, einem ganzen Komplex von bis dahin schlecht und verworren gekennzeichneten Dokumenten einen koh{{\"{a}}}renten Status zu geben, und hat sich dem Geist der Sprache als derart angemessen erwiesen, dass er andere, analog gebildete Begriffe hervorgebracht hat, von denen zumindest der des »apres-texte« geblieben ist. [{{\ldots}}] »Die Differenz zwischen //dem Text// (dem abgeschlossenen, d.h. publizierten) und dem ›avant-texte‹ besteht darin, dass der erste uns als ein in schicksalhafter F{{\"{u}}}gung fixiertes Ganzes geboten wird, w{{\"{a}}}hrend der zweite seine eigene Geschichte in sich tr{{\"{a}}}gt und enth{{\"{u}}}llt«.\n\nANNOTE\n86:\nDefinitorische Hauptmerkmale des Textes: Autor, Werk, Leser, Gesellschaft\n\n91:\nForschungsinteresse an Prozessen von Textentstehung als Untersuchungsgegenstand\n--> Werk als prinzipiell offener Proze{{\ss}}\n\n\nGunter Martens\n\n92:\nMartens' dynamischer Textbegriff verdankt sich einer rezeptions{{\"{a}}}sthetischen Vorstellung. Versteht Text als »materielles Artefakt«, dem ein »{{\"{a}}}sthetisches Objekt« zugeordnet ist. Ersteres dauert ohne Ver{{\"{a}}}nderung an, letzteres ist als ›Reflex und Korrelat‹ des Artefaktes im Bewu{{\ss}}tsein des Betrachters von der Einstellung des Rezipienten abh{{\"{a}}}ngig. Im Zusammenhang gesellschaftlicher und historischer Prozesse ver{{\"{a}}}nderbar.\n\nBachtin\n\n169:\n»Wir erfassen die Sprache nicht als ein System abstrakter grammatischer Kategorien, sondern als //ideologisch gef{{\"{u}}}llte// Sprache, Sprache als Weltanschauung und sogar als konkrete Meinung«.\n\nAbkehr von struktural-linguistischer, abstrakter Betrachtung der Sprache als synchronem System von Regeln und Zeichen, als //langue//.\n\nJan Assmann\n\n248:\nTexte sind im Gegensatz zu Ritualen nicht auf zeitlich und r{{\"{a}}}umlich geregelte Partizipation angelegt. Sie erlauben die Teilnahme an Sinnstiftungsprozessen einer Kultur in »zerdehnter Kommunikation«. \n\nClifford Geertz\n\n271f:\nKultur als Text. Sie wird verstanden als »selbstgesponnenes Bedeutungsgewebe, als »ineinandergreifende Systeme auslegbarer Zeichen«\n\nsemiotischer Kulturbegriff\n\nInterpretation symbolisch codierter Bedeutungsgeflechte},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Kammer, Stephan and L{\"{u}}deke, Roger},
file = {:C\:/07_THEORIE/_ToSort/AT001013DC60B4589B432C1257C3C004256AC.pdf:pdf},
keywords = {Text},
pages = {9\,----------------\,21},
title = {{Texte zur Theorie des Textes}},
year = {2005}
}
