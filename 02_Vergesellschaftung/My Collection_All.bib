doi = {10.1007/BF03172820},
file = {:C\:/07_THEORIE/Philosophy/Associationism/Pr{\^{e}}teur, Louvet-Schmauss - How french and German children of preschool age conceptualize the writing system - 1992.pdf:pdf},
issn = {02562928},
journal = {European Journal of Psychology of Education},
keywords = {Children of preschool age,Conceptualization of the writing system,Preschool education system,Social background},
