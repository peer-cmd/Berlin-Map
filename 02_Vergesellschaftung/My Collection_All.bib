isbn = {9780199256044},
issn = {0023-9216},
pmid = {14202000},
publisher = {Oxford University Press},
title = {{Reassembling the Social: An Introduction to Actor-Network Theory.}},
url = {http://doi.wiley.com/10.1111/j.1540-5893.2007.00319_3.x},
year = {2005}
}
