@article{Stjernfelt2000,
abstract = {The purpose of the paper is to outline Peirce's notion of "diagram", its place in his thought, and its actuality in relation to cognitive science and philosophy. Diagrams constitute a subspecies of icons, signs functioning by similarity, or, in Peirce's nontrivial account, functioning by permitting the obtaining of new knowledge about their object. Diagrams are the vehicle of all kinds of deduction, hence, their central role, because they permit the intuitive grasping of logical inferences. Consequently, they include a broader range of sign types than ordinarily presumed: maps, graphs, schemata, but also formal languages, syntax, algebra which are diagrammatical to the extent they permit the obtaining of new knowledge by diagram experimentation.},
author = {Stjernfelt, Frederik},
file = {:C\:/07_THEORIE/Authors/Peirce/Stjernfelt - Diagrams as centerpiece of a Peircean epistemology - 2000.pdf:pdf},
