journal = {Computing for a Better Tomorrow, (Ecaade 2018), Vol 2},
keywords = {algorithmic thinking,architectural education,computational thinking,frei otto,parametric model},
number = {Senske 2011},
pages = {401--410},
title = {{Parametric Models and Algorithmic Thinking in Architectural Education}},
