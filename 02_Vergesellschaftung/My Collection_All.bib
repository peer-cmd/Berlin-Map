@article{Friendly2008,
abstract = {Statistical graphics and data visualization have long histories, but their modern forms began only in the early 1800s. Between roughly 1850 and 1900 (±10), an explosive growth occurred in both the general use of graphic methods and the range of topics to which they were applied. Innovations were prodigious and some of the most exquisite graphics ever produced appeared, resulting in what may be called the "Golden Age of Statistical Graphics." In this article I trace the origins of this period in terms of the infrastructure required to produce this explosive growth: recognition of the importance of systematic data collection by the state; the rise of statistical theory and statistical thinking; enabling developments of technology; and inventions of novel methods to portray statistical data. To illustrate, I describe some specific contributions that give rise to the appellation "Golden Age". {\textcopyright}Institute of Mathematical Statistics, 2008.},
author = {Friendly, Michael},
doi = {10.1214/08-STS268},
file = {:C\:/07_THEORIE/Authors/Adolphe Quetelet/20697655.pdf:pdf},
issn = {08834237},
journal = {Statistical Science},
keywords = {Charles joseph minard,Data visualization,Florence nightingale,Francis galton,Francis walker,History of statistics,Smoothing,Thematic cartography,and phrases,charles joseph minard,data visualization,florence,francis galton,francis walker,history of statistics,ing,nightingale,smooth,thematic cartography},
number = {4},
pages = {502--535},
title = {{The golden age of statistical graphics}},
volume = {23},
year = {2008}
}
