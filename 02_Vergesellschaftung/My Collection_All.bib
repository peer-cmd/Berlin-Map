@article{Williamson2018,
abstract = {Towards the end of writing this book during the summer of 2015 we attended the Musicians' Union's (MU's) thirty-sixth Biennial Conference in Brighton. By this point, having pored through conference reports dating back to 1943,1 we were all too familiar with the nature and concerns of such gatherings and our attendance presented an obvious opportunity to reflect on the differences and similarities between the current machinations of the Union and those evident throughout the history we had just written. The conferences are arguably the most visible representation of the Union's concerns at any given point, as its Executive Committee (EC) reports on the organisation's work and delegates put forward motions supporting or criti- quing this work, while also having the opportunity to change Union policy. We observed that of the many changes the most apparent are in the demo- graphics and dynamics of the conference. This is visible amongst both the delegates on the conference floor and the EC and Secretariat on the podium. Conference pictures from the 1950s are notable for the almost complete lack of women amid the smoke-filled rooms of the colleges within which they tra- ditionally took place. By},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
