@article{Dentith2018,
abstract = {Talk of fake news is rife in contemporary politics, but what is fake news, and how, if anything, does it differ from news which is fake? I argue that in order to make sense of the phenomenon of fake news, it is necessary to first define it and then show what does and does not fall under the rubric of 'fake news'. I then go on to argue that fake news is not a new problem. Rather, if there is problem with fake news it is its centrality in contemporary public debate.},
