@article{KathySteeleSuzetteBoon2012,
abstract = {Reviews the book, Coping with Trauma-Related Dissociation: Skills Training for Patients and Therapists by S. Boon, K. Steele & O. van der Hart (see record 2011-05077-000). As the first treatment manual for people with complex developmental trauma disorders, this book is a must-have resource for clinicians who have ever worked or will ever work with clients with complex trauma histories. The in-depth attention paid not only to recognizing and working with dissociative self-parts but also to self-care concerns, including sleep, nourishment, relaxation, emotional and cognitive processes, inter- and intrapersonal relationships, and coping strategies, makes the book useful for non-dissociative clients as well. In addition to the excellent concrete skills-training approaches and well written psychoeducational material offered in this manual, one of the book's greatest contributions to clients is its nonpathologizing, compassionate language and respect for dissociative symptoms as functional responses to dysfunctional environments. The approaches offered are primarily informed by cognitive behavior and mindfulness therapy but also align well with psychodynamic, relational, and humanistic approaches to treatment. Group and individual therapists alike who work with people with complex dissociative disorders will benefit more from this book than from any other treatment manual currently in existence. (PsycINFO Database Record (c) 2012 APA, all rights reserved)},
author = {{Kathy Steele, Suzette Boon}, Onno van der Hart},
