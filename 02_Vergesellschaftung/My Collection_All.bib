@book{Reichel2007,
abstract = {While hybrid construction is still the norm today, in the mid-20th century modernism exposed the beauty of steel permanently. Modernism also gave rise to new concerns about performance and safety that Building Teams still wrestle with today. Steel dominates the marketplace for buildings with long spans, such as office, industrial, and convention facilities. Among steel's many benefits, design flexibility and standardization as well as construction scheduling and installed performance are among the highest. FULL TEXT Structural steel has been the framing material of choice for more than a century. By the start of World War II the steel frame had become an architectural commonplace; after the war, it exploded into broad usage, when the steel industry, working with structural engineers, worked out solutions to such problems as corrosion, fire resistance, and structural efficiency. In early designs, according to Michael Stratton in Structure and Style (Taylor &Francis, 1997), iron and steel members were often encased in concrete for fire protection. Floor decks were also often composite affairs blending the tensile strength of steel and the compressive power of concrete. While hybrid construction is still the norm today, in the mid-20th century modernism exposed the beauty of steel permanently. Modernism also gave rise to new concerns about performance and safety that Building Teams still wrestle with today. The main tension is between efficiency-yes, sustainability-and the building's stability under a variety of environmental and load conditions over the long term. Malleable, machinable, and ever-forgiving, steel has survived this balancing act and will continue to do so for a long time. Steel dominates the marketplace for buildings with long spans, such as office, industrial, and convention facilities. In addition, according to structural engineer Ronald O. Hamburger, SECB, a senior principal in the San Francisco office of engineering firm Simpson Gumpertz &Heger, steel is commonly used in hospitals, high-rise hotels, retail projects, aircraft hangars, covered stadiums, sports complexes, and airport terminals. "Steel can span large bay distances, thus minimizing the number of vertical columns and opening larger floor plan areas," notes Michael McLane, AIA, principal of Taylor, a Newport Beach, Calif., architecture and interior design firm. "Hospitals and large medical offices are like beehives in the sense that remodeling and upgrading interior spaces over relatively short periods of time is a constant activity," says McLane. "Larger column spacing allows more freedom of design in new and remodeled spaces." BUILDING TEAM ADVANTAGES Among steel's many benefits, Hamburger ranks design flexibility and standardization as well as construction scheduling and installed performance among the highest. "The principal advantage of steel is its rapid erection time. Speeding the construction schedule for a project often results in reduced construction cost," he notes. "Another important advantage of structural steel is its light weight. Particularly in areas of high seismic risk, this translates to reduced strength requirements for the lateral force-resisting system and reductions in project cost." "Steel offers the greatest value in terms of strength and ductility, pound for pound, compared to most construction materials," says Saif M. Hussain, S.E., a structural engineer and managing principal with Coffman Engineers, Los},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Detail},
booktitle = {Building with Steel},
file = {:C\:/07_THEORIE/Architecture/Birkh{\"{a}}user/Detail Practice/Building with Steel by Alexander Reichel (z-lib.org).pdf:pdf},
isbn = {9783764383862},
title = {{Building with Steel: Details, Principles, Examples}},
year = {2007}
}
