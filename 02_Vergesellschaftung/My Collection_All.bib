@article{Haraway1995,
abstract = {Ein Manifest f{\"{u}}r Cyborgs Ziel: Ironischer politischer Mythos, der Feminismus, Sozialismus und Materialismus die Treue h{\"{a}}lt (Warum Ironie? Warum ist Ironie so wichtig?) Ironie nimmt Widerspr{\"{u}}che, die nicht einmal dialektisch aufl{\"{o}}sbar sind, ernst. Sie ist blashphemisch gegen{\"{u}}ber Feminismus, Sozialismus und Materialismus, abersoll ihnen trotzdem die Treue halten. Die Grundthese ist dabei, dass moderne Hochtechnologien, vor allem nennt sie in diesem Zusammenhang immer wieder Biologie und Mikroelektronik, auf eine „intrigante`` (67) Weise unsere Konzepte von Menschsein, von Gender, class und race unterlaufen und {\"{u}}berwinden, und zwar auf eine solch doppeldeutige Weise, dass ihre Intriganz auch subversiv und empowernd genutzt werden kann. Sie will ausdr{\"{u}}cklich auch Wissenschaft und Technologie nicht d{\"{a}}monisieren, sondern verantwortungsvoll instrumentalisieren, um darauf eine bessere Zukunft zu bauen. (Vielleicht liegt es gar nicht so fern, hier die Suche nach einer nicht-entfremdeten Beziehung zur Technologie zu suchen, oder, mit Hegel, den Versuch des Subjekts, sich in den Dingen immer wieder selbst wiederzufinden.) Irritierend ist ihre positive Besetzung des Mythos. Cyborgs sind einerseits l{\"{a}}ngst Realit{\"{a}}t, andererseits aber symbolisieren sie f{\"{u}}r Harraway auch die Hoffnung auf eine Welt, die sich davon frei macht, ein h{\"{o}}heres Gesetz zur Beherrschung von K{\"{o}}rpern zu nutzen, ein Gesetz, das auf eine Art Nat{\"{u}}rlichkeit oder Ganzheit zielt. Das hei{\ss}t nat{\"{u}}rlich, dass sie K{\"{o}}rper nicht-naturalisiert denken will. Weil sie aber kein Telos mehr haben, haben die Cyborg auch keine Ursprungsgschichte im „westlichen Verst{\"{a}}ndnis``. Die Cyborg leben bereits in einer post-gender-Welt. Sie bezeichnet es als finale Ironie, dass die Cyborg letztlich eine Geschichte hat als Traum vom Mann in den Weiten des Weltall. Marxismus und Psychoanalyse postulieren immer eine urspr{\"{u}}ngliche Einheit. Cyborg haben keine urspr{\"{u}}ngliche Einheit mehr. Die Cyborg ist eine Anh{\"{a}}ngerin von „Partialit{\"{a}}t, Ironie, Intimit{\"{a}}t und Perversit{\"{a}}t``. Der Mythos beruht auf der {\"{U}}berschreitung von drei Grenzen: Tier-Mensch, Organismus-Maschine, Physikalisch- nichtphysikalisch. Sie selber wirft das Problem auf (40), dass der Cyborgmythos auch einfach die totale Aneignung des (weiblichen) K{\"{o}}rpers durch die (m{\"{a}}nnliche) abstrakte Macht bedeuten k{\"{o}}nnte. DIe Vergleichung und {\"{U}}bersetzung von K{\"{o}}rpern und F{\"{a}}higkeiten und die Kontrolle auf Basis von Statistiken und Wahrscheinlichkeiten setzt sie in Zusammenhang mit der universellen {\"{U}}bersetzung im Wert bei Marx, ist aber der Meinung, dass es etwas anderes sei: Es geht nicht um eine Art Biopolitik, sondern um eine Simulation von Politik, die weitaus m{\"{a}}chter sei und den Subjekten auch ein gr{\"{o}}{\ss}eres Aktionsfeld zur eigenen Erm{\"{a}}chtigung biete (50). Sie stellt dem auch gegen{\"{u}}ber, dass es auch als eine Welt ohne Angst vor der {\"{U}}berschreitung dieser Grenzen sein k{\"{o}}nnte. Beide Blickwinkel m{\"{u}}ssten gleichzeitig eingenommen werden. Herrschaft und Aneignung der Natur sollen also {\"{u}}ber harmonistische Vorstellungen einer urspr{\"{u}}nglichen Einheit oder des blo{\ss}en Bewahrens hinausgedacht werden. Solidarit{\"{a}}t verdankt sich einer freiwilligen Wahl, keiner fundamentalen Gemeinsamkeit. Deshalb spricht sie auch von affinity groups als Bezugsgruppen: Ihr Zusammenhalt basiert auf blo{\ss}er Affektion. Das gilt zum Beispiel auch f{\"{u}}r den Feminismus: Es gibt kein weiblich-sein. Affinit{\"{a}}t statt Identit{\"{a}}t. Damit werden alle politischen Kollektivsubjekte, die auf einer gemeinsamen Identit{\"{a}}t beruhen, untergraben. Der sozialistische Feminismus konstruiert die Kategorie Frau epistemologisch auf Basis einer marxistischen Ontologie, n{\"{a}}mlich der Arbeit. Das gilt sogar noch f{\"{u}}r den radikalen Feminismus, von dem sie sich bewusst abgrenzt: Auch dieser basiere noch auf einer besonders totalisierenden Epistemologie. Sie wendet sich gegen jede politische Theorie von Totalit{\"{a}}t und bef{\"{u}}rwortet Partialit{\"{a}}t, um die Vielzahl der m{\"{o}}glichen Stimmen einzubeziehen. Harraway scheint durchaus zu sehen, wie schmal der Grat ist, auf dem sie mit ihrem Cyborg-Konzept der Emanzipation wandelt: DIe N{\"{a}}he zur intrumentellen Verf{\"{u}}gung {\"{u}}ber K{\"{o}}rper ist im Text immer pr{\"{a}}sent und immer auch die Quelle m{\"{o}}glicher Befreiung. (Aber es bleibt schlussendlich auch ein bisschen unschl{\"{u}}ssig, wie sie dem entkommen will.) Die sog. Hausarbeits{\"{o}}konomie ist die Diagnose einer Zeit, in der, prototypisch am Silicon Valley zu erleben, die ihre Arbeitskr{\"{a}}fte, die bisher m{\"{a}}nnliche waren, entqualifiziert, und in ein Arbeitsregime verpflanzt, das eigentlich feminisiert ist: Prek{\"{a}}r, entqualifiziert, jederzeit flexibel und mobil, neu zusammensetzbar, „auf Sex reduzierbar`` (?). Diese Arbeitsform weitet sich {\"{u}}ber Frauen aus und verllgemeinert sich, wobei aber zugleich auch neue, hochqualifizierte Arbeitspltz{\"{a}}e entstehen, die auch jenen offenstehen, die bisher als gering qualifiziert galten. Das f{\"{u}}hrt sogar dazu, dass Frauen immer {\"{o}}fter f{\"{u}}r das ganze Familieneinkommen verantwortlich sind, was auch die Grundlage f{\"{u}}r ein neues B{\"{u}}ndnis von Frauen sein kann, insbesondere auch von schwarzen Frauen. Diese Form von Familie entspricht der sp{\"{a}}ten Phase des Kapitalismus. Sie ist in Anlehnung an das Milit{\"{a}}r organisiert und erm{\"{o}}glicht die Ausbreitung dessen Establishments. Die Video- und Computerspielkultur ist daf{\"{u}}r in kultureller Hinsicht das {\"{A}}quivalent. Ein bisschen deutlicher wird es, als Harraway ihren Mythos von der Cyborg am Beispiel des Schreibens ausbuchstabiert: Schreiben ist eine Kulturtechnik, die in der westlichen, imperialistischen Ideologie den kolonisierten Menschen aberkannt wurde. Schriftlose Kulturen galten als geringwertig. In der Entkolonisierung, aber auch vor allem in der Befreiung der Sklaven war daher das Lernen des Schreibens auch eine Form der Selbsterm{\"{a}}chtigung. Schrift hat f{\"{u}}r diese Gruppen eine besondere Bedeutung. Aber sie als Cyborgs d{\"{u}}rfen nicht den Fehler machen, dieses Werkzeug so zu verwenden, wie es unspr{\"{u}}nglich gegen sie verwendet wurde, n{\"{a}}mlich als Ausdruck einer imaginierten Ganzheit oder Einheit, einer Unschuld, der es anh{\"{a}}ngt und die es anstrebt. Das Schreiben ist nicht unschuldig, es ist das Ergreifen des Werkzeugs, das fr{\"{u}}her die Unterdr{\"{u}}ckung schuf, in der Absicht, sich damit selbst zu befreien, {\"{u}}ber das Bezeichnen und das Erz{\"{a}}hlen von Geschichten. Es geht ihnen dabei einfach um das {\"{U}}berleben. Marxismus und Feminimus westlicher Art haben bisher immer versucht, das unschuldige Subjekt zu identifizieren, das am Ende {\"{u}}ber die Ungerechtigkeit pobsiegen wird. Das hat nicht funktioniert und ist nicht mehr zeitgem{\"{a}}{\ss}, denn ein solches unschuldiges Subjekt hat es nie gegeben. Vor diesem Hintergrund konnten Erz{\"{a}}hlungen immer als irgendeine Trag{\"{o}}die begriffen werden, die vom Verlust einer Unschuld handelt, die aber au{\ss}erdem auch erm{\"{o}}glichte, Frauen entweder als per se bessere oder schlechtere Menschen zu kennzeichnen. Dieser Konzeption gegen{\"{u}}ber steht die Cyborg: Z.B. die wirkliche Frau, die in einer Kultur aufgewachsen ist, die dem Untergang geweiht ist, und die ihre eigenen Wege und Machtf{\"{a}}higkeiten gefunden hat, mit denen sie sich eine Zukunft verschaffen kann oder muss. Diese, z.b. denke man an Frauen aus s{\"{u}}dostasiatischen D{\"{o}}rfern, die nun in westlichen Elektronikfabriken arbeiten, w{\"{u}}rden nun aktiv daran arbeiten, die „Texte ihrer K{\"{o}}rper und Gesellschaften aktiv umzuschreiben``. (67). (Was hei{\ss}t das? Tun sie das wirklich? Ist das blo{\ss}e {\"{U}}berleben wirklich ein Umschreiben irgendeines Textes oder ist es nicht blo{\ss}{\"{U}}berleben?) Zuletzt wird feministische Science Fiction genannt. (68ff)},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Haraway, Donna Jeanne},
file = {:C\:/07_THEORIE/_ToSort/20_Haraway_Manifest_Cyborgs-LETZTESEITEFEHLT.pdf:pdf},
isbn = {3-593-35241-9 ; 978-3-593-35241-1},
keywords = {(s)Biologie / (s)Feminismus / (f)Aufsatzsammlung},
pages = {237 S.},
title = {{Die Neuerfindung der Natur}},
year = {1995}
}
