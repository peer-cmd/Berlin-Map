file = {:C\:/07_THEORIE/_ToSort/03.pdf:pdf},
issn = {10158758},
journal = {Acta Theologica},
keywords = {Action problem,Methodology,Practical theology,Practice-oriented research,Practices,Research strategy},
pages = {26--44},
title = {{Practice-oriented research in service of designing interventions}},
volume = {2015},
