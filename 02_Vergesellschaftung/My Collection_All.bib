@article{Calhoun1996,
abstract = {Part of a review symposium (see abstracts of related articles) on a book by Martin Jay, Downcast Eyes: The Denigration of Vision in Twentieth-Century French Thought (Berkeley: U of California Press, 1993), which chronicles the organizing tension between phenomenology/existentialism & structuralism/poststructuralism in modern French thought. Jay does a laudable job of analyzing the impact of issues of vision on a myriad of cultural analyses, theories, fictions, & related works & charting how the antiocular discourse has challenge the dominant status of visuality in Western cultural traditions. The book is written with great theoretical acuity & succeeds in identifying & cataloging issues. However, in its stated attempt to weave issues of vision into a whole cloth of 20th-century French thought, the book fails; no sense of real unity emerges. D. Generoli (Copyright 1997, Sociological Abstracts, Inc., all rights reserved.)},
