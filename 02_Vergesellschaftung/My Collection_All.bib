file = {:C\:/07_THEORIE/Philosophy/Post-Foundational/Laclau_Raumtheorie/New Reflections on the Revolution of Our Time (Ernesto Laclau).pdf:pdf},
isbn = {9781351494175},
journal = {Reflections on the Revolution of Our Time},
pages = {1--466},
title = {{Reflections on the revolution of our time}},
year = {2017}
}
