@article{Griffin2007,
abstract = {A city is not only the corollary of a street, rather by virtua of its network of rivers, canals, and news channels, a city is the point at which all these paths meet. (718). In this piece, Kittler uses various analogies to suggest that the city is not so much a space as much as a technology that mediates information to us vis a vis various networks. Media exists to process, record, and transmit numbers. A Greek city, probably Milet, provides us with two of our oldest forms of media: the coin and the vowel alphabet. Rome, in order to extend itself from a city into a state, adopted the most advanced form of oriental transmission media: the Acahemenidian postal system The technological media miniaturize the city, while magnifying the entropy of megalopolis Through its monuments, written records, and ordrderly habits of association, the city enlarged the scope of all human activities, by extending them backwards and forwards in time, (720-21). In this way, capital cities function to mediate the state to its occupants. Such an appeal is not a digression to power however, as when we cling to the clearcut centrality of the head in thinking the concept capital, it may be that we still have not cut off the head of the king. The monarchs, to whom Europe owes most of its capitals, might thereby be said to have transcended architecture and achieved immortality in the head o theory itself, (717). That is, our theories of state act as memorials- and keep the spirit alive- of those who we decry. The act of theorizing against the concept of capitals simultaneously acknowledges it as a threat and gives it presence through utterance.},
author = {Griffin, Matthew and Kittler, Friedrich},
doi = {10.1353/nlh.1996.0051},
file = {:C\:/07_THEORIE/Authors/Kittler/F_Kittler_The City Is a Medium.pdf:pdf},
journal = {New Literary History},
number = {4},
pages = {717--729},
title = {{The City is a Medium}},
volume = {27},
year = {2007}
}
