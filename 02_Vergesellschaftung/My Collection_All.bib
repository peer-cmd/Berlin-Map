issn = {2040090X},
journal = {International Journal of Education Through Art},
keywords = {Embodied knowing,Integrity,Practice research,Validation},
number = {3},
pages = {343--354},
title = {{Bringing practice closer to research – seeking integrity, sincerity and authenticity}},
volume = {11},
year = {2015}
}
