@article{Graham2003,
abstract = {This article discusses the reconfigurations of urban space in the U.S. resulting from changing technological practices. As of 2001, telecommunications and digital media industries endlessly proclaim the death of distance and the ubiquity of bandwidth. Paradoxically, however, they actually remain driven by the old-fashioned geographic imperatives of putting physical networks in trenches, conduits and emplacements to drive market access. The greatest challenge of the multiplying telecommunications firms in large cities is what is termed the problem of the last mile. The hard material basis for the digital revolution is neglected but crucial. Focusing on it allows analysis to begin to reveal the complex social and technological practices that surround and support the explosion of digitally-mediates economic and cultural flows. Such an approach also begins to reveal the subtle and powerful reconfigurations of urban space that are the result of such changing technological practices. The current explosion of a digitally configured and electronically-mediated international capitalist system presents clear challenges to critical urban research. Research on the relationships between digital capitalism and the city is growing rapidly, these agendas remain peripheral to too many urban disciplines and conceptualizations, simply because electronic mobilities and flows have never been a central foundation or urban sociology, geography or anthropology.},
author = {Graham, Stephen},
doi = {10.1111/1468-2427.00318},
file = {:C\:/07_THEORIE/IGTG/Identit{\"{a}}t und Ort/191180.pdf:pdf},
issn = {0309-1317},
journal = {International Journal of Urban and Regional Research},
number = {2},
pages = {405--410},
title = {{Information Technologies and Reconfigurations of Urban Space}},
volume = {25},
year = {2003}
}
