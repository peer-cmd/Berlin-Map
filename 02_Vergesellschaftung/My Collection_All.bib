@book{Erickson2021,
abstract = {For over twenty years, A History of Anthropological Theory has provided a strong foundation for understanding anthropological thinking, tracing how the discipline has evolved from its origins to the present day. The sixth edition of this important text offers substantial updates throughout, including more balanced coverage of the four fields of anthropology, an entirely new section on the Anthropocene, and significantly revised discussions of public anthropology, gender and sexuality, and race and ethnicity. Written in accessible prose and enhanced with illustrations, key terms, and study questions in each section, this text remains essential reading for those interested in studying the history of anthropology. On its own or used with the companion volume, Readings for a History of Anthropological Theory, sixth edition, this text provides comprehensive coverage in a flexible and easy-to-use format for teaching in the anthropology classroom.},
