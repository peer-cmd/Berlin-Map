author = {Bratton, Benjamin and Stack, The and Earth, Spaceship and Bratton, As and Galloway, Alex and Virilio, Paul and Earth, Google and Schmitt, Carl and Schmitt, For and Innis, Harold},
file = {:C\:/07_THEORIE/IGTG/2022-23_WS_The Stack/Tuters_Scenario Theory – Review of Benjamin H. Bratton, The Stack on Software and Sovereignty Computational Culture.pdf:pdf;:C\:/07_THEORIE/_ToSort/Computational+Culture.pdf:pdf},
isbn = {9780262029575},
