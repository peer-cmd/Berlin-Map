file = {:C\:/07_THEORIE/_ToSort/Borsi Porter Notitngham 2016.pdf:pdf},
issn = {2407-9472},
journal = {Athens Journal of Architecture},
number = {1},
pages = {45--64},
title = {{The Typology of the Berlin Block: History, Continuity and Spatial Performance}},
volume = {2},
