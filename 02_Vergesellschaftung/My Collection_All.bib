@article{Mitchell2005c,
abstract = {Estudou-se a situa{\c{c}}{\~{a}}o epidemiol{\'{o}}gica da raiva bovina em Minas Gerais de 1998 a 2006. Foram avaliadas 6873 fichas de diagn{\'{o}}stico de raiva por imunofluoresc{\^{e}}ncia direta. Para an{\'{a}}lise da distribui{\c{c}}{\~{a}}o temporal da raiva, foram constru{\'{i}}das tabelas e gr{\'{a}}ficos no software Excel 2003 e o mapeamento dos diagn{\'{o}}sticos foi feito no aplicativo Tabwin 1.4. Verificou-se tend{\^{e}}ncia anual decrescente do n{\'{u}}mero de exames e dos diagn{\'{o}}sticos positivos (Y= -41,133x+544,89). Os meses de maio, junho e julho apresentaram o maior percentual de diagn{\'{o}}sticos positivos. O n{\'{u}}mero de munic{\'{i}}pios com raiva bovina variou ao longo do per{\'{i}}odo estudado e manteve tend{\^{e}}ncia decrescente (Y= -7,0833x+166,64), com expans{\~{a}}o da doen{\c{c}}a para os munic{\'{i}}pios da regi{\~{a}}o do Tri{\^{a}}ngulo Mineiro},
author = {Mitchell, W J T},
