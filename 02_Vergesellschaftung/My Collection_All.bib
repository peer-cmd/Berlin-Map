@article{Adams2011,
abstract = {Reviews the book, Doctoring the mind: Is our current treatment of mental illness really any good by Richard P. Bentall (see record 2009-17635-000). There are some good things about this book. It is competently written and quite readable. The text is eloquent in its support of a recovery oriented approach. Author Richard Bentall advocates for the active involvement of mental health consumers in their own treatment. Despite the helpful treatments recommended and the relevant questions underscored by Bentall's text, we would be reluctant to recommend it to anyone because we found the book to be incendiary and divisive. One central premise seems to be that there is a long-standing battle for supremacy going on between psychology and psychiatry. The text suggests that those in the former profession are educated and trained to understand people and the human experience and to provide healing therapy. Bentall also argues that the case for a genetic cause of mental illnesses has been grossly overstated by psychiatrists and that symptoms such as psychosis are much more the result of psychosocial stressors. (PsycINFO Database Record (c) 2012 APA, all rights reserved).},
author = {Adams, Curtis and Hackman, Ann},
doi = {10.1176/ps.62.5.pss6205_0570},
file = {:C\:/07_THEORIE/Authors/Bentall/Doctoring the Mind Is Our Current Treatment of Mental Illness Really Any Good (Richard P. Bentall) (Z-Library).pdf:pdf},
issn = {1075-2730},
journal = {Psychiatric Services},
