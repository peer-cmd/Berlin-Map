@article{Mendoza2009,
abstract = {One of the most common activities of human beings is that of decision making, which is the logical process required to arrive at a decision among several alternatives. Decision problems appear in most areas of education, notably in planning and research. Ideas related to decision theory can be traced back at least to the eighteenth century. However, most of the formal developments have emerged during the past 80 years. In this article, we are concerned with normative decision theory. We discuss the solution of a general class of decision problems and comment on the relationship between decision theory and statistical inference, a discipline often referred to as the science of making decisions under uncertainty.},
