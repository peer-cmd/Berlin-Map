isbn = {9780199207565},
journal = {Very Short Introductions},
keywords = {-ALL NO PDF,ALL,ALL BOOKS,ALL NO PDF,books mend.ris},
pages = {129},
title = {{Autism: A Very Short Introduction}},
url = {https://play.google.com/store/books/details?id=j40SDAAAQBAJ%0Ahttp://veryshortintroductions.com/view/10.1093/actrade/9780199207565.001.0001/actrade-9780199207565%0Ahttp://dx.doi.org/10.1093/actrade/9780199207565.001.0001},
