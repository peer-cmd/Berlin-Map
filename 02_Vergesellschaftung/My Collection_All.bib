file = {:C\:/07_THEORIE/Disciplines/Law/On the Origin of the Right to Copy Charting the Movement of Copyright Law in Eighteenth-Century Britain (1695-1775) (Ronan Deazley) (Z-Library).pdf:pdf},
isbn = {9781847310385},
issn = {0013-8266},
