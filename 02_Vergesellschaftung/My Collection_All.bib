file = {:C\:/07_THEORIE/Disciplines/Artificial Intelligence/Unknown - 2020 - AI Narratives - A History of Imaginative Thinking about Intelligent Machines - Unknown.pdf:pdf},
journal = {AI Narratives},
title = {{AI Narratives}},
year = {2020}
}
