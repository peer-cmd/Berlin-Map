@article{Norberg-Schulz1971,
abstract = {In this book we offer a new approach to the problem of architectural space. So far, the discussion of architectural space has been dominated by naive realism, either disguised as studies in 'architectural perception' or as tri-dimensional geometry. In both cases the basic problem of space as a dimension of human existence is omitted with the result that the space concept is nowadays often regarded as outdated or even superflous. I still believe, however, that the space concept is particularly suited for the analysis of the human environment. On the basis of a theory of 'existential space', I therefore develop the idea that architectural space may be understood as a concreteization of environmental schemata or images, which form a necessary part of man's general orientation or 'being in the world''. I believe therby to have established a simple and useful key to the architectural totality.},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Norberg-Schulz, Christian},
file = {:C\:/07_THEORIE/_Scribd_ID_Files/326413831-Existence-Space-and-Architecture-Art-eBook.pdf:pdf},
keywords = {Architectural design,Cognition,SPATIAL RELATIONS,design theory,perception,space},
pages = {120},
title = {{Existence, Space & Architecture}},
year = {1971}
