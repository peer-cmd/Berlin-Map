doi = {10.3389/fpsyg.2012.00576},
file = {:C\:/07_THEORIE/_ToSort/Gaesser - 2013 - Constructing memory, imagination, and empathy A cognitive neuroscience perspective - Frontiers in Psychology.pdf:pdf},
issn = {16641078},
journal = {Frontiers in Psychology},
keywords = {Empathy,Episodic memory,Episodic simulation,Functional magnetic resonance imaging,Imagination,Mental simulation,Prosocial behavior,empathy,episodic memory,episodic simulation,functional magnetic resonance,imagination,imaging,mental simul,mental simulation,prosocial behavior},
