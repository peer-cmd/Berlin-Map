issn = {09217126},
journal = {AI Communications},
keywords = {Data,History of science,Philosophy of science,Statistical artificial intelligence},
number = {1},
pages = {37--43},
title = {{On the current paradigm in artificial intelligence}},
volume = {27},
year = {2014}
}
