@incollection{Nicholas1993,
abstract = {From the ruins of Soviet communism, Boris Groys emerges to provoke our interest in the aesthetic goals of its founders. Like modernists elsewhere, the totalitarian artists and theorists of the USSR longed for an art that could transform the world it once sought only to depict. The revolutionaries of October 1917 promised to create a society that was not only more just and more economically stable but also more beautiful, and they intended that the entire life of the nation be completely subordinate to Communist Party leaders commissioned to regulate, harmonize, and create a single “artistic” whole out of even the most mundane aspects of existence. What were the origins of this idea? And what were its artistic and literary ramifications? In addressing these issues, Groys questions the view that socialist realism was an “art for the masses.” In this new edition for Verso, Groys revisits the debate that the book has stimulated since its first publication.},
annote = {reclassified from @misc to @incollection: has booktitle= field, biblex-maintenance protocol, 2026-08-16},
author = {Groys, Boris},
booktitle = {The Slavic and East European Journal},
doi = {10.2307/308486},
