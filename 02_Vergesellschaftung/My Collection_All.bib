isbn = {9781728143651},
journal = {2019 Third International conference on I-SMAC (IoT in Social, Mobile, Analytics and Cloud) (I-SMAC)},
keywords = {breast cancer,decision tree,k-nearest neighbours,logistic regression,support vector machine,svm},
number = {113},
pages = {13--21},
title = {{M Achine L Earning : W Hat Is M Achine L Earning ?}},
volume = {11},
year = {2015}
}
