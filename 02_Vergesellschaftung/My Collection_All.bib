@article{Wittek2001,
abstract = {Einleitung. Die gesellschaftliche Konstruktion der Wirklichkeit und das Modell der soziologischen Erkl{\"{a}}rung Situation und Situationsanalyse Das Thomas-Theorem Die Objektivit{\"{a}}t der Situation Interesse und Kontrolle 4.1 Interesse - Die Intensit{\"{a}}t der Interessen - Die Hierarchie der Bed{\"{u}}rfoisse - Die Idee des Interesses - Internalisierung - Werte - Die Organisation der Interessen - Die Verfassung" des Selbst - Wertewandel und Werteverfall 4.2 Kontrolle - Erworbene und askriptive Eigenschafien - Technik, Wissenschaft und Institutionen - Macht und Herrschaft - Die" Dialektik" der Herrschaft - Rechte 4.3 Kooperation und Konflikt - Unteilbare Ressourcen, die nur gemeinsam erstellt werden k{\"{o}}nnen - Interdependenzen und antagonistische Kooperation Interdependenzen aus typischen Verteilungen von Kontrolle und Interesse Konkurrenz um Ressourcen, die nur einer kontrollieren kann (=Positionsg{\"{u}}ter) Konflikte Konstantsummenkonflikt: knappe Ressourcen mit privater Nutzung k{\"{o}}nnen nicht so aufgeteilt werden, dass jd. etwas hat, ohne dass jd anderes weniger davon hat Nullsummenkonflikte: was ein hat, hat jd. anders weniger der eigene Nutzen schadet anderen reine Kooperation Alle haben ein Interesse an etwas und arbeiten daran gemeinsam Integration von Orientierungen, Handeln, sozialem System vs. antagonistische Kooperation - Kontrollinteresse und konstitutionelles Interesse Kontrollinteresse Interesse am Erhalt der bisher interessanten Ressourcen Kontrolle bisher nicht kontrollierter Resosurcen Spezialf{\"{a}}lle: - Kooperationsinteresse + gemeinsame gewinnbringende Projekte - Transaktionsinteresse + gewinnbringende Verteilung und Tausch konstitutionelles Interesse Interesse die Verfassung so zu beeinflussen, dass die selbst kontrollierten Ressourcen h{\"{o}}her bewertet werden eigene Kontrolle auf Dauer abzusichern institutionelle Konflikte w{\"{u}}rden besonders intensiv gef{\"{u}}hrt - Zwei Arten von Konflikten Interessenkonflikte Spezifisches und generalisiertes Kapital Kontrollkonflikte Die Heftigkeit der Kontrollkonflikte Der Konflikt um die Kontrolle der Definitionsmacht - Integration - Noch einmal: Die Professoren Die "Definition" der Situation Handeln Die Wert-Erwartungstheorie},
