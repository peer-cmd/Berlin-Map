@article{Hughes2019,
abstract = {In his published lectures on economic psychology Gabriel Tarde defined society as a "web of interspiritual actions, of mental states working upon each other." He then applied this idea to economic behavior, but more especially to study of leisure; for it is by wider distribution of leisure among levels of the population that the arts of consumption are made to flourish. This work of Tarde's, which has been completely ignored by social scientists, should be read and discussed, as should other sociological classics, not for specific hypotheses but as a source of ideas to be used in setting and studying problems.},
author = {Hughes, Everett C and Riesman, David and Becker, Howard S},
doi = {10.4324/9781315135045-57},
