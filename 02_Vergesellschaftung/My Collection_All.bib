@article{Kaiser1999,
abstract = {This ambitious study argues that our modern conception of the aesthetic\nsphere emerged during the era of British and German Romanticism from\nconflicts between competing models of the liberal state and the cultural\nnation. The aesthetic sphere is thus centrally connected to 'aesthetic\nstatism', which is the theoretical project of reconciling conflicts\nin the political sphere by appealing to the unity of the symbol.\nDavid Kaiser traces the trajectory of aesthetic statism from Schiller\nand Coleridge, through Arnold, Mill and Ruskin, to Adorno and Habermas.\nHe analyses how the concept of aesthetic autonomy shifts from being\na supplement to the political sphere to an end in itself; this shift\nlies behind the problems that contemporary literary theory has faced\nin its attempts to connect the aesthetic and political spheres. Finally,\nhe suggests that we rethink the aesthetic sphere in order to regain\nthat connection.},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Kaiser, David},
doi = {10.1017/cbo9780511484315},
file = {:C\:/07_THEORIE/Philosophy/romanticism/Kaiser - Romanticism, Aesthetics, and Nationalism - 1999.pdf:pdf},
journal = {Romanticism, Aesthetics, and Nationalism},
keywords = {experimental,realia,scraps,speaking},
number = {1},
pages = {9--15},
title = {{Romanticism, Aesthetics, and Nationalism}},
volume = {4},
year = {1999}
}
