@book{Capaldi2004,
abstract = {Nicholas Capaldi's biography of John Stuart Mill traces the ways in which Mill's many endeavours are related and explores the significance of Mill's contribution to metaphysics, epistemology, ethics, social and political philosophy, the philosophy of religion, and the philosophy of education. He shows how Mill was groomed for his life by both his father James Mill, and Jeremy Bentham, the two most prominent philosophical radicals of the early nineteenth century. Yet Mill revolted against this education and developed friendships with both Thomas Carlyle and Samuel Taylor Coleridge who introduced him to Romanticism and political conservatism. A special feature of this biography is the attention devoted to his relationship with Harriet Taylor. No one exerted a greater influence than the woman he was eventually to marry. Nicholas Capaldi reveals just how deep her impact was on Mill's thinking about the emancipation of women.},
author = {Capaldi, Nicholas},
booktitle = {John Stuart Mill: A Biography},
doi = {10.1017/CBO9780511498053},
file = {:C\:/07_THEORIE/Authors/Mill, John Stuart/Capaldi - John stuart mill A biography - 2004.pdf:pdf},
isbn = {9780511498053},
pages = {1--436},
title = {{John stuart mill: A biography}},
year = {2004}
}
@article{Ladd2002,
abstract = {The Marx-Engels monument completed in 1986 in East Berlin offers a striking stylistic contrast to the Ernst Th{\"{a}}lmann monument dedicated the same year in the same city. While the Th{\"{a}}lmann monument represented a Soviet tradition and was the work of a Soviet sculptor, the unheroic, horizontally arrayed sculptures of the Marx-Engels monument had supplanted earlier plans for a more bombastic monument. That change was a victory for East German artists. However, the location of the monument was shifted away from the central square, Marx-Engels-Platz, a decision that revealed the East German leaders' lukewarm commitment to the project amid shifting priorities in matters of urban planning. The compromises that led to the final form of the Marx-Engels monument were a product of leaders' attempts to use the project to satisfy different constituencies. Copyright {\textcopyright}2002 SAGE Publications.},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Ladd, Brian},
doi = {10.1177/00220094020370011101},
file = {:C\:/07_THEORIE/Architecture/Bauakademie/Ladd-EastBerlinPolitical-2002.pdf:pdf},
issn = {00220094},
journal = {Journal of Contemporary History},
number = {1},
pages = {91--104},
title = {{East Berlin political monuments in the late German Democratic Republic: Finding a place for Marx and Engels}},
volume = {37},
year = {2002}
}
