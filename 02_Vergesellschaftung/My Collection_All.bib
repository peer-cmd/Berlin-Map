@article{Galison1999,
abstract = {The question before the house during a two-day conference at Harvard University in 1994 was, "How do the buildings of science literally and figuratively configure the identity of the scientist and scientific fields?" Perhaps it has no categorical answer, but the conferees--architects, scientists, sociologists and historians--offered plenty of possibilities. Galison (a professor of the history of science and physics at Harvard) and Thompson (an assistant professor of the history and sociology of science at the University of Pennsylvania) assemble in this book several of the papers delivered at the conference, plus a few others. Among the subjects discussed are 19th-century science buildings, modern space, whether or not architecture is a science, hospitals, the Fermi National Accelerator Laboratory in Batavia, Ill. ("a scientific project in which architecture was of crucial importance," according to its former director, Robert R. Wilson), and the Lewis Thomas Laboratory at Princeton University as compared with the nearby Center for Advanced Biotechnology and Medicine in Piscataway, N.J. Illustrations, many of them eye-catching as well as apposite, abound. "It is our collective hope," the editors say, "that this volume will encourage a great deal more inquiry into the encounters between architecture and science."},
author = {Galison, Peter and Jones, Ca},
file = {:C\:/07_THEORIE/Authors/Galison/Galison, Jones - 1999 - Factory, laboratory, studio Dispersing sites of production - Architecture of Science.pdf:pdf},
journal = {Architecture of Science},
pages = {497--540},
title = {{Factory, laboratory, studio: Dispersing sites of production}},
url = {http://apps.webofknowledge.com/full_record.do?product=UA&search_mode=GeneralSearch&qid=21&SID=Y1mWbFUkJWWhhhkZGQp&page=1&doc=1},
year = {1999}
}
