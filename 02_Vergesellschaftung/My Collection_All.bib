@article{Jung1910,
abstract = {Os testes de associa{\c{c}}{\~{a}}o de Jung forneceram-me a prova experimental da tend{\^{e}}ncia para a introjec{\c{c}}{\~{a}}o. Segundo Jung, a principal caracter{\'{i}}stica do modo de rea{\c{c}}{\~{a}}o dos neur{\'{o}}ticos {\'{e}} o n{\'{u}}mero elevado de "rea{\c{c}}{\~{o}}es de complexo"; o neur{\'{o}}tico "interpreta a palavra indutora no sentido de seus pr{\'{o}}prios complexos". De modo geral, o indiv{\'{i}}duo normal responde rapidamente {\`{a}} palavra indutora com uma palavra induzida indiferente, associada por raz{\~{o}}es de sentido ou de sonoridade. No neur{\'{o}}tico, os afetos flutuantes apoderam-se da palavra indutora a fim de transferir para ela uma parte de sua energia, contentando-se com a associa{\c{c}}{\~{a}}o mais indireta. Completarei as conclus{\~{o}}es de Jung acrescentando que n{\~{a}}o {\'{e}} a palavra indutora que "deflagra" a rea{\c{c}}{\~{a}}o perturbada pelos complexos nos neur{\'{o}}ticos, mas s{\~{a}}o os afetos {\'{a}}vidos de descarga que v{\~{a}}o ao encontro da palavra indutora. Para recorrer {\`{a}} nossa express{\~{a}}o rec{\'{e}}m-criada, diremos que o neur{\'{o}}tico introjeta at{\'{e}} as palavras indutoras experimentais [Ferenczi, S. (1991). Transfer{\^{e}}ncia e Introjec{\c{c}}{\~{a}}o (1909). In S. Ferenczi (Ed.), Obras Completas I (Vol. I). S{\~{a}}o Paulo: Livraria Martins Fontes Editora, Ltda, 87]},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Jung, Carl Gustav},
doi = {10.2307/1413002},
file = {:C\:/07_THEORIE/Authors/Jung/Jung - The Association Method - 1910.pdf:pdf},
issn = {00029556},
journal = {The American Journal of Psychology},
number = {2},
pages = {219},
title = {{The Association Method}},
volume = {21},
year = {1910}
}
