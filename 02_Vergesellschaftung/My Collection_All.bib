@article{Hui2012,
abstract = {We find ourselves in a media-intensive milieu comprising networks, images, sounds, and text, which we generalize as data and metadata. How can we understand this digital milieu and make sense of these data, not only focusing on their functionalities but also reflecting on our everyday life and existence? How do these material constructions demand a new philosophical understanding? Instead of following the reductionist approaches, which understand the digital milieu as abstract entities such as information and data, this article proposes to approach it from an embodied perspective: objects. The article contrasts digital objects with natural objects (e.g., apples on the table) and technical objects (e.g., hammers) in phenomenological investigations, and proposes to approach digital objects from the concept of "relations," on the one hand the material relations that are concretized in the development of mark-up languages, such as SGML, HTML, and XML, and on the other hand, Web ontologies, the temporal relations that are produced and conditioned by the artificial memories of data. {\textcopyright}2012 The Authors.},
annote = {Relinked in V7: original file path was dead on disk; matched to file that appears moved/renamed.},
author = {Hui, Yuk},
doi = {10.1111/j.1467-9973.2012.01761.x},
file = {:C\:/07_THEORIE/IGTG/Semiotik - Cybernetiks/Yuk Hui/Hui - What is a digital object - 2012.pdf:pdf},
issn = {00261068},
journal = {Metaphilosophy},
keywords = {Simondon,Stiegler,a philosophical investigation is,attempt to outline what,develop a philosophy of,digital objects,history of,i call digital objects,in this article i,it is possible to,metadata,necessary by revisiting the,phenomenology,philosophy and proposing that,showing that,simondon,stiegler},
number = {4},
pages = {380--395},
title = {{What is a digital object?}},
volume = {43},
year = {2012}
}
