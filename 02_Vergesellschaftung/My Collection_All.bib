@article{Whately1880,
abstract = {THE TONGUE, LIKE much of our human anatomy, works so unobtrusively that we may be excused for taking it for granted. It has, of course, a time-honoured place in the diagnosis of illness, but even now doubt is being cast on the value of the furred tongue (Loudon 1956), and soon inspection of the tongue may be denounced as unreliable, worthless, or even positively misleading, to be replaced at the earliest possible moment by a biochemistry report. It is perhaps a pity that one particular function of the human tongue-articulation in speech-is not associated with any known change in its anatomy; that would doubtless have made it a much more intriguing organ than it appears to be. Against a background of comparative anatomy, however, the tongue stands out as a more interesting organ than most, showing clearly that fascinating aspect of design in Nature-the linking of structure and function. In phylogeny, the tongue first appears in some fishes as a rudimentary organ, and is an almost constant feature of vertebrates above that level. Morphologically, it is an appendage of the hyoid part of the branchial skeleton, which means that the many forms of tongue are simply variations of the anatomy of the floor of the mouth. Each difference in form probably has a direct connection with habit and function, but the variations are so numerous that exactly what the connection is must often be left to the imagination. In the higher mammals the tongue is typically an elongated muscular organ, somewhat flattened or rounded, with an anterior or oral part, and a posterior or pharyngeal part. The proportion of these areas varies greatly between the mammalian groups, the pharyngeal part often being relatively small. In man, they form two-thirds and one-third of the dorsum respectively, and are separated by the sulcus terminalis and foramen caecum-two features seldom seen clearly. Unlike most other tongues, even among the Primates, the human tongue has no papillae on its pharyngeal part; the surface is uneven because of little nodules of lymphoid tissue, but it is smooth, A most interesting variation in form of this typical mammalian tongue is the inter-molar eminence-an elevation on the surface of the oral part, due to a thickening of tongue substance. It occupies the posterior end of the oral part, lies close to the hard palate, between the molar teeth, and is ringed behind and at the side by circumvallate papillae. Commonly found in herbivorous ungulates and rodents, it is undoubtedly associated with the thorough mastication typical of these creatures. The inter-molar 185 R. M. LIVINGSTON eminence, one must presume, is mechanical and gustatory in function; in front of it the tongue is flat or rounded, mobile and free, and is con-cerned with bringing the food into the mouth-a prehensile function (Fig. 1). Taken from a recent description of the movements of the human Fig. 1. Tongue of a buffalo showing the inter-molar eminence covered with},
author = {Thomas, Whately},
doi = {10.1515/9781782046264-005},
file = {:C\:/Users/peerf/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Whately - 1880 - Observations on Modern Gardening.pdf:pdf},
journal = {Observations on Modern Gardening, by Thomas Whately},
number = {4},
pages = {25--214},
title = {{Observations on Modern Gardening}},
volume = {1880},
year = {2024}
}
