@article{Francis2008,
abstract = {In 1558 the first horticultural manual written in English and solely dedicated to the 'Arte' of gardening was published by Thomas Hill, facilitated by the new print culture, which, for the first time, enabled books to be produced, distributed and sold relatively cheaply. This publication began a steady flow of gardening literature during the remainder of the sixteenth century and the early seventeenth century. Examining both language and content, this paper sets out to consider the contribution these gardening manuals make to an understanding of early modern society, revealing the writers to be as concerned to intervene in contemporary social and moral debate as they were to offer gardening advice, and showing how they placed themselves firmly within the prevalent rhetoric of order that underpinned every area of contemporary life. Consideration of other primary sources contextualizes these ideas, relates theory to gardening practice, and, rather than revisiting the already well-researched grand gardens of the nobility, evaluates the somewhat scanty evidence referring to the more modest gardens of the ordinary householder to see if and how the prescription is borne out by practice across social boundaries. CR - Copyright &#169; 2008 The Garden History Society},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Francis, Jill},
doi = {10.2307/25472392},
file = {:C\:/07_THEORIE/_JSTOR/Francis - 2008 - Order and Disorder in the Early Modern Garden, 1558-C.1630 - Garden History.pdf:pdf},
issn = {03071243},
journal = {Garden History},
number = {1},
pages = {22--35},
title = {{Order and Disorder in the Early Modern Garden, 1558-C.1630}},
