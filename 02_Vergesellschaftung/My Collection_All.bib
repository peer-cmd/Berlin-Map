isbn = {9781118328705},
keywords = {Chymical medicine,Corpuscular metric,Essay,Experimental philosophy,John Locke,Mathematics,Natural philosophy,Newton,Speculative philosophy},
pages = {64--81},
title = {{Locke and Natural Philosophy}},
year = {2015}
}
