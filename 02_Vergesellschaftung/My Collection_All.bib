@article{Cixous2005,
abstract = {Cixous deconstructs the oppressive binaries she encounters in literature, and attempts to develop a non-hierarchical writing practice, the "feminine," which offers a way out of binary thinking. Her approach draws on pscyhoanalysis in that it seeks to understand texts as expressing the inner life of the writer, whether consciously or unconsciously. Ecriture feminine seeks to reflect women's sexuality and awareness of their own bodies. However, this writing is not exclusive to female writers. Because women have long been denied the right to language and writing, they must "write themselves": "Woman must write her self: must write about women and bring women to writing, from which they have been driven away as violently as from their bodies-for the same reasons, by the same law, with the same fatal goal. Woman must put herself into the text-as into the world and into history-by her own movement" (1524). Cixous assumes that women have in common the fact of their repression: "I'm speaking of woman in her inevitable stuggle against conventional man; and of a universal woman subject who must bring women to their senses and to their meaning in history" (1524). However, Cixous does not claim that there is any sort of "general woman" or "typical woman": "what strikes me is the infinite richness of their individual constitutions" (1524). Although most writing until now, even that of women, has not been in any way different from male writing, it can be, because "writing is precisely the very possibility of change, the space that can serve as a springboard for subversive thought, the precursory movement of a transformation of social and cultural structures" (1526). The link between writing, reason, and truth is part of the problem. Poetry holds the most potential because it "involves gaining strength through the unconscious and because the unconscious, that other limitless country, is the place where the repressed manage to survive" (1527). Woman must write herself at two, inseparable levels. At the level of the individual, she must write the body, which has been devalued and "confiscatd from her": "Censor the body and you censor breath and speech at the same time" (1527). Women must also be intent on "seizing the occasion to speak, hence her shattering entry into history, which has always been based on her suppression" (1527). Woman's speech involves and inscribes the body (1528). However, "It is impossible to define a feminine practice of writing, and this is an impossibility that will remain, for this practice can never be theorized, enclosed, coded-which doesn't mean that it doesn't exist" (1529). The feminine writing Cixous envisions does not fall prey to the compartmentalization of masculine writing: "Her language does not contain, it carries; it does not hold back, it makes possible" (1533).},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {Cixous, H{\'{e}}l{\`{e}}ne and Cohen, Keith and Cohen, Paula},
doi = {10.1086/493306},
file = {:C\:/07_THEORIE/_ToSort/H_Cixous_The laugh of the medusa.pdf:pdf},
issn = {0097-9740},
journal = {Signs: Journal of Women in Culture and Society},
number = {4},
pages = {875--893},
title = {{The Laugh of the Medusa}},
volume = {1},
year = {2005}
}
