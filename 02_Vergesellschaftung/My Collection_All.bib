issn = {13684310},
journal = {European Journal of Social Theory},
keywords = {Emile Durkheim,William James,emotions,pragmatism,religion},
number = {3},
pages = {337--353},
title = {{William James: Pragmatism, Social Psychology and Emotions}},
volume = {7},
year = {2004}
}
