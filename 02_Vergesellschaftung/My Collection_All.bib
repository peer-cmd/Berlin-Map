doi = {10.1353/hyp.2004.0002},
file = {:C\:/07_THEORIE/Authors/Anderson/Anderson, Elizabeth (2009) Uses of Value Judgements in Science. A General Argument, with Lessons from a Case Study of Feminist Research on Divorce.pdf:pdf},
