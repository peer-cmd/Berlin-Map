@article{Language2011,
abstract = {The so-called 'honey-guides' of flowers were first described by SPRENGEL in 'Das entdeckte Geheimniss' (I793). He believed that these markings on the flower helped to guide the visiting insect to the place where the nectar was stored. He says, 'If now an insect, attracted by the beauty of the corolla, or by an agreeable odour, has gone to a flower, it will either forth- with perceive the nectar, or, if this is in a concealed place!, will not perceive it. In the latter case Nature comes to the rescue with the nectar-guide. This consists of one or several spots, lines, dots, or markings of another colour than that of the corolla as a whole, and consequently conspicuous against its lighter or darker tint. It is always placed just where the insects must creep in if they are to reach the nectar'. (AINSWORTH-DAVIES' translation, I906). SPRENGEL did not do any real experiments on honey-guides, but he collected numerous examples, and he deduced from them, as quoted above, not only that these patterns guided insects, but that they only affected close-range orientation, after the insect had already been attracted to the flower. Several people have experimented on the subject since SPRENGEL and their opinions have varied as to the effect which such patterns can have on visiting insects. There are two main questions that can be posed with regard to honey-guides.},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]JSTOR enrichment (2026-07-21, jstor_enrich pipeline, source Welt - « In Wahrheit gibt es nur Atome und leeren Raum » Die griechischen Gelehrten und ihre antike Atomphysik - 2011.pdf): added journal from JSTOR PDF front-matter text.},
author = {Language, Natural},
file = {:C\:/07_THEORIE/_JSTOR/Welt - « In Wahrheit gibt es nur Atome und leeren Raum » Die griechischen Gelehrten und ihre antike Atomphysik - 2011.pdf:pdf},
journal = {Antike Welt},
number = {4},
pages = {8--14},
title = {{In Wahrheit gibt es nur Atome und leeren Raum» Die griechischen Gelehrten und ihre antike Atomphysik}},
volume = {2},
year = {2011}
}
