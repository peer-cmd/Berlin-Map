@book{Ghosh2022,
abstract = {The Protestant Ethic (PE) is the most misunderstood text in the canon of modern political and social theory and for a good reason: it compresses most of the thought of an inter-disciplinary polymath into the shortest possible space. Weber was not a systematic thinker and there is no single PE ‘thesis'. Instead the text is a set of inter-linked ideas with multiple foci, and this explains the lay-out of the exposition here. There are four sections: (1) examination of the text's ‘Reception' and some influential misreadings by social scientists and historians. (2) ‘Rationality and Capitalism', where capitalism is the outstanding individual reality of modernity and rationality the set of pervasive, formal procedures that run through it. The central subject of the whole PE, ascetic Protestantism, is a rationalizing Protestantism. (3) ‘Ethics and Religion', on the supersession of traditional Christian and Biblical ethics by a wholly modern code of conduct. (4) ‘Politics', on Weber's little-known arguments for the historic role of religion in setting limits to the exercise of political power. The method throughout is that of the history of ideas: to look for ‘what Weber really thought', and only then turn to its present-day theoretical implications.},
author = {Ghosh, Peter},
booktitle = {The Routledge International Handbook on Max Weber},
doi = {10.4324/9781003089537-14},
file = {:C\:/07_THEORIE/Authors/Weber/The Protestant Ethic and the Spirit of Capitalism (Max Weber) (z-lib.org).pdf:pdf},
isbn = {9781000642179},
pages = {145--157},
title = {{the Protestant Ethic and the Spirit of Capitalism (1904–5/1920)}},
year = {2022}
}
