@book{DAmore,
abstract = {This book illuminates a lesser-known aspect of the British history of travel in the Enlightenment: that of the Royal Society's special contribution to the "discovery" of the south of Italy in the age of the Grand Tour. By exploring primary source journal entries of philosophy and travel, the book provides evidence of how the Society helped raise the Fellows' curiosity about the Mediterranean and encouraged travel to the region by promoting cultural events there and establishing fruitful relations with major Italian academic institutions. They were especially devoted to revealing the natural and artistic riches of the Bourbon Kingdom from 1738 to 1780, during which the Roman city of Herculaneum was discovered and Vesuvius and Etna were actively eruptive. Through these examples, the book draws attention to the role that the Royal Society played in establishing cultural networks in Italy and beyond. Tracing a complex path starting in Restoration times, this new insight into discourse on learned travel contributes to a more challenging vision of Anglo-Italian relations in the Enlightenment. Preface; Acknowledgements; A Note on Editorial Policy; Contents; List of Figures; 1 Introduction; 1.1 At the Root of the Grand Tour of the South: Exceptional Travellers and Academies; 1.2 From Far-off Lands to the Bel Paese: Geographical and Cultural Spaces; 1.3 Learned Letters as Cultural Communication Tools; Bibliography; Primary Sources; Anthologies; Extracts from Philosophical Transactions; Secondary Sources; Learned Travel before the Grand Tour: The Royal Society 1665-1700; 2 The Fellows' Letters from Distant Countries: New Science, the "Other" and Imperialism. 2.1 On "Arithmeticall Navigation": New Directions, Tools and Maps for Learned Seamen2.2 Corresponding with the Fellows: Scientific Accounts and Early Travel Narratives; 2.3 Confronting the "Other": (Biased) Descriptions of Turkey, Japan and Newfoundland; 2.4 The Savages' Skills for the Benefit of England: Natural Knowledge and Imperialism; Bibliography; Primary Sources; Extracts from Philosophical Transactions; Secondary Sources; 3 News from the Mainland: Mapping Physical and Intellectual Spaces Before the Grand Tour; 3.1 From Present to Past: Science, Technology and Archaeology in France. 3.2 Letters from Expert Navigators: Dutch Ships, Maps and Accounts of Foreign Lands3.3 On the Beauties of Nature: From the Icy Peaks of Switzerland to Mediterranean Fruitful Flora; Bibliography; Primary Sources; Extracts from Philosophical Transactions; Secondary Sources; 4 On the Ancients and the Power of Nature: The Special Case of Italy; 4.1 Paving the Way for Learned Travel: Britons' Cultural Interest in Italy; 4.2 Beyond Experimental Science: In Search of the Roman Remains of the Past; 4.3 Destructive Earth: Eruptions and Earthquakes in Naples and Catania; Bibliography; Primary Sources. Extracts from Philosophical TransactionsSecondary Sources; The Grand Tour of South Italy: The Discovery of the Two Sicilies 1700-1800; 5 Southern Paths for Learned Travellers: The Discovery of Herculaneum and of the Neoclassical Mediterranean; 5.1 Communicating Archaeology: The Mystery of Herculaneum Unveiled (1739-1760); 5.2 More on Past "Curiosities": Following the Pre-classical Thread (1760-1780); Bibliography; Primary Sources; Extracts from Philosophical Transactions; Secondary Sources; Addendum; 6 Images of Sublime Sicily. 6.1 The Fellows' Path to the Extreme South: from Hamilton's Vesuvius to Etna6.2 At the Origins of the Grand Tour of Sicily: Picturesque Nature in the Fellows' Eyes; Bibliography; Primary Sources; Extracts from Philosophical Transactions; Secondary Sources; 7 From Letters to Memoirs and Travel Accounts: The Fellows as &!blank; "Cultural Mediators"; 7.1 Johann Georg Keyssler: Depicting the Sharp Contrasts in Early Modern Naples; 7.2 "Off the Old Beaten Track": Patrick Brydone's Sicily; 7.3 On the Eve of the New Century: Thomas Watkins's Travels in the "Deep South"; Bibliography; Primary Sources.},
annote = {[relink-2026-07-26: 1 file path(s) updated for 07_THEORIE folder reorg, method=basename-match, tiers=['unique']]},
author = {D'Amore, Manuela},
file = {:C\:/07_THEORIE/Historiography/Grand Tour/The Royal Society and the discovery of the two Sicilies southern routes in the Grand Tour (DAmore, Manuela) (Z-Library).pdf:pdf},
isbn = {9783319552910},
pages = {319},
title = {{The Royal Society and the discovery of the two Sicilies : southern routes in the Grand Tour}}
}
