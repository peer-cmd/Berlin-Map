@article{Wolf1987,
abstract = {The recent reassessment of Wundt's contribution to psychology offers the opportunity of reconsidering his influence on Durkheim. Earlier attempts were either based on a distorted image of Wundt or remained assertions which were not substantiated. Durkheim used Wundt's description of the relationship between strength of stimulus and quality of feeling (Gef{\"{u}}hlston,) to buttress his argument on the role of the pursuit of happiness as a cause of the growth of the division of labour. Initially he did not adopt Wundt's interpretation of the relationship between stimulus and feeling. Wundt stressed the relative autonomy of mental processes when dealing with complex feelings. Later, Durkheim moved much more closely to Wundt's position, when he started to emphasize the role of collective ideals and ideas. However, he differed fundamentally from Wundt in his emphasis on the primacy of society in his description and explanation of collective representations. This is reflected in the reception given t{\"{o}} Wundt's "V{\"{o}}lkerpsychologie" by Durkheim and Mauss. - The same pattern can be found in Wundt's inf{\`{i}}uence on Durkheim's study of morality. Initially, Durkheim criticized Wundt for neglecting the importance of natural feelings of affinity which gave rise to social inclinations and stressing too much the voluntary and idealistic sides of moral behaviour. Later, however, Durkheim came to integrate these latter aspects in his ethical theory. Finally, his stress on the importance of society led Durkheim to reject the universalistic humanitarian claims of Wundt's ethics and to embrace a version of the homo duplex doctrine, which could be said to be the opposite of Wundt's image of man.},
author = {Jacob, Jan and de Wolf, Jan Jacob},
file = {:C\:/07_THEORIE/Authors/Durkheim/Jacob, Wolf - 1987 - Wundt and Durkheim A Reconsideration of a Relationship - Anthropos.pdf:pdf},
journal = {Anthropos},
keywords = {Cultural psychology,Experimental psychology,Moral development,Morality,Myths,Philosophical psychology,Physiological stimulation,Psychology,Psychophysiology,Social psychology},
number = {82},
pages = {1--23},
title = {{Wundt and Durkheim a Reconsideration of a Relationship}},
url = {http://www.jstor.org/stable/40462297},
volume = {1./3.},
year = {1987}
}
@article{Brioschi2014a,
abstract = {The aim of the present paper is to explore the connection between Peirce's theory of abduction and his cosmology, showing how his metaphysical and cosmological thoughts are required by his logical theory of abduction. To reach this goal, I first consider by and large the specific issue at stake-that is creativity-and then I briefly touch upon creativity's implications to both Peirce's "popular" theory of abduction, and his "unpopular" cosmology. Second, I tackle abduction and creativity with special reference to Peirce's description of lume naturale and hope, and third I show how a critical account of abduction and creativity leads us toward cosmology and metaphysics. As a result, we will see how abduction and creativity involve a cosmology and need to be sustained by Synechism, in order to be fully comprehended and explained.},
author = {Brioschi, Maria Regina},
issn = {1809-8428},
keywords = {Abduction,Cosmology,Creativity,Hope,Peirce,a,abduction,abdu{\c{c}}{\~{a}}o fundamental,como a criatividade se,cosmology,creativity,de peirce,hope,peirce,vincula {\`{a}}},
pages = {157--166},
title = {{Peirce'S "Fundamental Abduction": How Creativty Entails Cosmology}},
url = {http://www.pucsp.br/pragmatismo},
volume = {11},
year = {2014}
}
