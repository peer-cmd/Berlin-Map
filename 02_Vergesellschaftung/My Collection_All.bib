@book{Moser2018b,
abstract = {Papers presented at a conference in honor of the 100th birthday of Ernst Gombrich, held 2009 in Greifswald, Germany. "Ernst H. Gombrich, the Art Historian, master of both Continental thought and English language, became one of the world's most well-known representatives of the discipline. Half a century ago his testable theories transformed thinking on how to look at art. After only a few years during which semiotics appeared to render Sir Ernst's common-sense framework outdated, the rise of cognitive approaches has enabled him to recover internationally the status he once had in France as a radical thinker within modern philosophy. This book explores Gombrich's intellectual legacy by analysing some of the concepts and insights in the context of Image Science, the 'Steckenpferd'. The international contributors are original authorities in their own right, among them some of Gombrich's former students"--Back cover},
