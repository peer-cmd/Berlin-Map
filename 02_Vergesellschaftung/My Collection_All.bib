@article{Symes2016,
abstract = {[The dominant and all-pervasive cultural movement of the eighteenth century was the Enlightenment, where nature was a central preoccupation. The 'natural' garden was enabled and encouraged to flourish, though its relationship with the Enlightenment was perceived to be closer on the continent. The natural garden had a long history, with different emphases and aspects entering over a considerable time frame, and was productive of many variants. Lancelot Brown's work is considered from a number of angles, but set against a background of the natural garden.]},
