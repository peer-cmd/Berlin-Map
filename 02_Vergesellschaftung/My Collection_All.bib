@book{Maschler2009,
abstract = {Animal behavior can be studied using game theory models. A game theory model is a simplified representation of the essential aspects of a behavioral system in a form that makes testable predictions. Each model is based on a set of assumptions, which specify and simplify the system being modeled, and a payoff matrix that formally states the fitness benefits gained by one behavioral strategy when it plays other strategies. I will discuss the use of game theory models in the study of animal behavior and will illustrate with well-known examples of contests (the hawk-dove and hawk-dove-retaliator model) and cooperation (the prisoner's dilemma and iterated prisoner's dilemma). I will also discuss the contributions of game theory models to the development of the honest communication viewpoint.},
