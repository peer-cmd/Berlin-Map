@article{Hoplin1990,
abstract = {This paper stresses the notion that Expert Systems (ES) are more than a change in the system. ES change the thinking process and, therefore, the framework for thinking which opens new fields of' vision. This provides a window which fills voids in the conventional management process. Using largely non-technical terms, connection is made between the state of the art in business and a sense of the appIicability and limitations for improving users productivity as well as the quality of management through the use of ES frameworks in critical areas of the organization. By considering ES as software programs designed to emulate a human expert, it is with relative ease that applications tc) sustain superior performance of a soon-to-be-retired expert are now in demand. This demand requires two sometimes far-flung resources: in-house functional expertise and a knowledge engineer to capture the expert's reasoning. ES is now playing a vital role as a facilitator in bringing together these components where management is ready to commit personnel to an ES project. This is possible now that management has a better understanding of, for example, the data bases and the software systems involved. Environmental issues as well as technical, managerial, and people issues will be addressed. "Smart Databases" and the dynamics of management decision making will also be discussed as compelling reasons for developing ES. The concepts in the paper are based partially on the esoteric foundati$\sim$,ns of ES, but also on extended study of people and organizational behavior. A balanced view is maintained by investigating the technology ;tpl$\sim$roach and wtl:lt might be called the user or business needs appro;lch. Some researchers feel that the ES market will be "technologically drivt:n", but there is more and more backing of the spread of ES from the direction of demand driven applications. This paper aims at fostering the ES concept in the business world in the 1990's and beyond with the overriding conclusion that ES is a solution to many of the most persistent problems now prevalent in the business world. For this to take place on a permanent basis, a change is required in the thought process-not a procedural change in the systems development cycle.},
annote = {Relinked in V7: original file path was dead on disk; matched to file that appears moved/renamed.},
author = {Hoplin, Herman P and Erdman, Stephen J},
doi = {10.1145/97709.97710},
file = {:C\:/07_THEORIE/IGTG/2023-24_WS_Architektur mit AI/Hoplin, Erdman - 1990 - Expert systems An expanded field of vision for business.pdf:pdf},
isbn = {0897914163},
journal = {Proceedings of the 1990 ACM SIGBDP Conference on Trends and Directions in Expert Systems, SIGBDP 1990},
keywords = {Artificial intelligence (AI),Data base management systems (DBMS),Decision support systems (DSS),Expert systems (ES),Knowledge- based (KB)},
pages = {1--16},
title = {{Expert systems: An expanded field of vision for business}},
year = {1990}
}
